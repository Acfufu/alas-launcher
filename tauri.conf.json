{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AzurLaneAutoScript",
  "version": "0.1.0",
  "identifier": "moe.taiho.alas-launcher",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Alas",
        "width": 1280,
        "height": 880,
        "url": "about:blank",
        "acceptFirstMouse": true,
        "visible": false,
        "create": false
      },
      {
        "label": "splash",
        "title": "Alas Launcher",
        "width": 640,
        "height": 180,
        "url": "about:blank",
        "acceptFirstMouse": true,
        "visible": true,
        "create": true
      }
    ]
  }
}
